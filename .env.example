# Copy to .env. Generate non-demo values for both secrets before deployment.
FLASK_SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret
JWT_ACCESS_TOKEN_SECONDS=3600

# Defaults to a local SQLite file. For PostgreSQL, use a URL such as:
# postgresql+psycopg://researchvault:your-password@localhost:5432/researchvault
DATABASE_URL=sqlite:///researchvault.db
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_FOLDER=backend/uploads

# SMTP is required for production password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional: without a key, the API returns a grounded extractive answer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Dense local embeddings; install backend/requirements-embeddings.txt.
EMBEDDING_MODE=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE=faiss
RETRIEVAL_MIN_SIMILARITY=0.12
RETRIEVAL_MIN_HYBRID_SCORE=0.08

